{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "doh.pub": [
            "1.12.12.12",
            "120.53.53.53",
            "2402:4e00::",
            "2402:4e00:1::"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4",
            "2001:4860:4860::8888",
            "2001:4860:4860::8844"
          ]
        }
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "✈️proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "pub",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "google"
      },
      {
        "rule_set": [
          "adblock",
          "BlockHttpDNS"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "query_type": [
          "SVCB",
          "HTTPS"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": [
          "apple@cn",
          "microsoft@cn",
          "category-games@cn",
          "cn"
        ],
        "action": "evaluate",
        "server": "ali",
        "tag": "ali-res"
      },
      {
        "rule_set": [
          "apple@cn",
          "microsoft@cn",
          "category-games@cn",
          "cn"
        ],
        "action": "evaluate",
        "server": "pub",
        "tag": "pub-res"
      },
      {
        "match_response": "ali-res",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "pub-res",
        "action": "respond",
        "race": true
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "google"
      }
    ],
    "final": "google",
    "cache_capacity": 16384,
    "optimistic": {
      "enabled": true,
      "timeout": "5m0s"
    },
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "stream_receive_window": 0,
      "connection_receive_window": 0
    },
    {
      "tag": "rules-download",
      "version": 2,
      "detour": "⚡️Auto"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": false,
      "endpoint_independent_nat": true,
      "mtu": 1500,
      "stack": "system",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "protocol": "ntp",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "vpn",
        "outbound": "vpn"
      },
      {
        "port": 993,
        "rule_set": "cn_ip",
        "action": "reject"
      },
      {
        "inbound": "tun-in",
        "process_name": [
          "Motrix",
          "aria2c"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "inbound": "tun-in",
        "rule_set": "cn_ip",
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff",
        "timeout": "100ms"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "✈️proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "adblock",
          "BlockHttpDNS"
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "rule_set": [
          "apple@cn",
          "microsoft@cn",
          "category-games@cn",
          "cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": [
              "quic",
              "stun"
            ]
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "port": [
              3478,
              5349,
              19302,
              19303,
              19304,
              19305,
              19306,
              19307,
              19308,
              19309
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "rule_set": "spotify",
        "action": "route",
        "outbound": "🎶Spotify"
      },
      {
        "rule_set": "ai",
        "action": "route",
        "outbound": "🤖AI"
      },
      {
        "rule_set": "tiktok",
        "action": "route",
        "outbound": "🎵TikTok"
      },
      {
        "rule_set": "instagram",
        "action": "route",
        "outbound": "📷Instagram"
      },
      {
        "rule_set": "paypal",
        "action": "route",
        "outbound": "💳PayPal"
      },
      {
        "rule_set": "emby",
        "action": "route",
        "outbound": "📺Emby"
      },
      {
        "rule_set": [
          "youtube",
          "netflix",
          "disney",
          "hbo",
          "hulu"
        ],
        "action": "route",
        "outbound": "🎬Media"
      },
      {
        "rule_set": [
          "telegram",
          "telegram_ip"
        ],
        "action": "route",
        "outbound": "✈️Telegram"
      }
    ],
    "auto_detect_interface": true,
    "find_process": true,
    "default_domain_resolver": "ali",
    "default_http_client": "default",
    "final": "🕸️final",
    "rule_set": [
      {
        "type": "remote",
        "tag": "BlockHttpDNS",
        "url": "https://raw.githubusercontent.com/senshinya/singbox_ruleset/main/rule/BlockHttpDNS/BlockHttpDNS.srs",
        "update_interval": "48h0m0s",
        "http_client": "rules-download",
        "format": "binary"
      },
      {
        "type": "remote",
        "tag": "apple@cn",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple@cn.srs",
        "update_interval": "48h0m0s",
        "http_client": "rules-download",
        "format": "binary"
      },
      {
        "type": "remote",
        "tag": "microsoft@cn",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/microsoft@cn.srs",
        "update_interval": "48h0m0s",
        "http_client": "rules-download",
        "format": "binary"
      },
      {
        "type": "remote",
        "tag": "category-games@cn",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-games@cn.srs",
        "update_interval": "48h0m0s",
        "http_client": "rules-download",
