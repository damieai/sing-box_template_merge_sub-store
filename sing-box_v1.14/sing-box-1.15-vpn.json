  },
  "outbounds": [
    {
      "tag": "✈️proxy",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "⚡️Auto",
        "🇭🇰Hong Kong",
        "🇹🇼Taiwan",
        "🇯🇵Japan",
        "🇰🇷Korea",
        "🇸🇬Singapore",
        "🇺🇸United States",
        "🌍Other",
        "direct"
      ],
      "default": "⚡️Auto"
    },
    {
      "tag": "🤖AI",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "⚡️Auto",
        "🇭🇰Hong Kong",
        "🇹🇼Taiwan",
        "🇯🇵Japan",
        "🇰🇷Korea",
        "🇸🇬Singapore",
        "🇺🇸United States"
      ],
      "default": "⚡️Auto"
    },
    {
      "tag": "🎵TikTok",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "✈️Telegram",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "📷Instagram",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "💳PayPal",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "📺Emby",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct",
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "🎶Spotify",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct",
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "direct"
    },
    {
      "tag": "🎬Media",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "✈️proxy",
        "⚡️Auto"
      ],
      "default": "✈️proxy"
    },
    {
      "tag": "🇭🇰Hong Kong",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰|HK|hk|香港|港|HongKong"
          ]
        }
      ]
    },
    {
      "tag": "🇹🇼Taiwan",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan"
          ]
        }
      ]
    },
    {
      "tag": "🇯🇵Japan",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇯🇵|JP|jp|日本|日|Japan"
          ]
        }
      ]
    },
    {
      "tag": "🇰🇷Korea",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇰🇷|KR|kr|韩国|韓國|Korea|Seoul"
          ]
        }
      ]
    },
    {
      "tag": "🇸🇬Singapore",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬|SG|sg|新加坡|狮|Singapore"
          ]
        }
      ]
    },
    {
      "tag": "🇺🇸United States",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸|US|us|美国|美|United States"
          ]
        }
      ]
    },
    {
      "tag": "🌍Other",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "🇭🇰|HK|hk|香港|香|🇹🇼|TW|tw|台湾|台|🇸🇬|SG|sg|新加坡|狮|🇯🇵|JP|jp|日本|日|🇺🇸|US|us|美国|美|🇰🇷|KR|kr|韩国|韓國|Korea|Seoul"
          ]
        }
      ]
    },
    {
      "tag": "⚡️Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 25,
      "interrupt_exist_connections": true,
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|地址|剩余|过期|时间|有效"
          ]
        }
      ]
    },
    {
      "tag": "🕸️final",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "⚡️Auto",
        "✈️proxy",
        "direct"
      ],
      "default": "⚡️Auto"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "vpn",
      "type": "selector",
      "outbounds": [
        "⚡️Auto",
        "direct",
        "{all}"
      ],
      "default": "⚡️Auto"
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "",
      "dashboard": {
        "enabled": true,
        "http_client": "default",
        "download_url": "https://ghfast.top/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": false,
      "store_dns": true
    }
  }
}
